# Frontend runtime configuration — copy to .env and fill in your
# deployment-specific values. Do NOT commit your real .env file.
#
# These are public client-side identifiers (not authentication secrets),
# but they are kept out of source control to avoid exposing account-specific
# infrastructure details.

# Lambda Function URL for the REST proxy (from CDK output RestProxyUrl)
VITE_API_URL=

# Cognito User Pool ID (e.g. us-east-1_XXXXXXXXX)
VITE_USER_POOL_ID=YOUR_USER_POOL_ID

# Cognito User Pool App Client ID
VITE_USER_CLIENT_ID=YOUR_CLIENT_ID

# Cognito Identity Pool ID (e.g. us-east-1:00000000-0000-0000-0000-000000000000)
VITE_IDENTITY_POOL_ID=YOUR_IDENTITY_POOL_ID

# AWS region
VITE_AWS_REGION=us-east-1
